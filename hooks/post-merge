#!/usr/bin/env bash
# After `git pull` brings in changes, keep the generated skills tree, runtime
# links, and global rules in step with the repo by re-running the sync.
# post-rewrite delegates here so `git pull --rebase` is covered too.
set -u

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo_root" || exit 0

# Pull was already up to date, or the rewrite produced no change — skip.
head_now="$(git rev-parse HEAD 2>/dev/null || true)"
head_before="$(git rev-parse ORIG_HEAD 2>/dev/null || true)"
if [ -n "$head_now" ] && [ "$head_now" = "$head_before" ]; then
    exit 0
fi

echo "[git hook] Pull changed the repository — running ./sync-agents.sh"
"$repo_root/sync-agents.sh" || echo "[git hook] sync-agents.sh failed (exit $?) — re-run it manually." >&2
exit 0
